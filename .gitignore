# Cada aplicación tiene su propio .gitignore (restaurant_pos/, administrador/)
*.log
.DS_Store
.env
.env.backup
.env.production
/.idea
/.vscode
/.zed
/.codex
/.cursor/
/.nova
Thumbs.db

# Sistema original (sólo referencia local): contiene respaldos SQL de clientes,
# credenciales en código y binarios. No se versiona.
/posgourmet/

# Respaldos de la BD legacy que se cargan en docker/legacy (sólo se versiona el README)
/docker/legacy/*
!/docker/legacy/README.md

# Volcados / respaldos sueltos
*.sql.gz
*.sql.zip
*.dump

# Metadatos de Windows/WSL
*:Zone.Identifier
desktop.ini

# Herramientas locales
/.claude/settings.local.json
/.claude/claude-code-chat-images/

APP_NAME="Mesatek"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8600
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=mesatek
DB_USERNAME=mesatek
DB_PASSWORD=mesatek

# Base MySQL del sistema original (sólo para: php artisan legacy:importar)
LEGACY_DB_HOST=legacy-db
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=posgourmet
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=root

# Opciones del POS (antes archivos .txt en la raíz del sistema legacy)
POS_SALON=false
POS_MESEROS_SIN_CODIGO=true
POS_CIERRE_DIARIO=true
POS_BILLAR=false
POS_SIN_VISTA_EMPLEADO=true
POS_IMPRESION_NUBE=true
POS_CAMBIO_FECHA=false
POS_ADMIN_PASSWORD=admin

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
